# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
# Get your paper keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER_TRADE=true

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Ollama must be running: `ollama serve`
# Pull a model first: `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── Event store (shared by news service and trading agent) ────────────────────
EVENT_STORE_PATH=data/events.db

# ── News service ──────────────────────────────────────────────────────────────
NEWS_LOOP_INTERVAL_MINUTES=30
WATCHLIST_TICKERS=AAPL,NVDA,MSFT,GOOGL,AMZN

# Optional news API keys (source skipped if unset; RSS always runs)
NEWSAPI_KEY=your_newsapi_key_here
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_KEY=

# ── Trading agent behaviour ───────────────────────────────────────────────────
LOOP_INTERVAL_MINUTES=60

# Committee
RESEARCH_SYMBOL_COUNT=6
ENABLE_DEBATE_ROUND=true
MAX_CYCLE_SECONDS=600
MAX_ORDERS_PER_CYCLE=3

# Event store query (trading agent)
EVENTS_SINCE_HOURS=72
EVENTS_MIN_IMPORTANCE=2
EVENTS_LIMIT=30
MACRO_EVENTS_MIN_IMPORTANCE=4
MACRO_EVENTS_LIMIT=10

# Max fraction of available cash to allocate per buy (0.0 – 1.0)
MAX_POSITION_PCT=0.05

# Enable thinking/reasoning mode (recommended for Qwen3+ models)
ENABLE_THINKING=true

# Print raw LLM thinking and decision JSON to stdout each cycle
VERBOSE=false
