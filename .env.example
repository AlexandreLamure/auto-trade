# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
# Get your paper keys at https://app.alpaca.markets/paper/dashboard/overview
# Paper keys start with PK; live keys start with AK.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER_TRADE=true

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Ollama must be running: `ollama serve`
# Pull a model first: `ollama pull qwen3:14b`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:14b
# Context window — Ollama defaults to 4096, which is too short for briefs. 16384 fits 16GB VRAM with headroom.
OLLAMA_NUM_CTX=16384
# Sampling temperature (below Ollama's usual ~0.8 default)
OLLAMA_TEMPERATURE=0.4

# ── Event store (shared by news service and trading agent) ────────────────────
EVENT_STORE_PATH=data/events.db

# Optional news API keys (source skipped if unset; RSS always runs)
NEWSAPI_KEY=your_newsapi_key_here
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
MARKETAUX_API_KEY=

# Signal source weights (JSON map of source type to weight)
SOURCE_WEIGHTS={"sec_edgar":1.0,"company_ir":1.0,"rss":0.9,"api":0.8,"reddit":0.5,"stocktwits":0.4,"polymarket":0.3,"google_trends":0.3}

# Company IR RSS feeds – JSON map of ticker to feed URL
# IR_RSS_FEEDS={"AAPL":"https://investor.apple.com/feed/press-release.rss"}

# SEC EDGAR requires a descriptive User-Agent
SEC_USER_AGENT=auto-trade/1.0 (contact@example.com)

# Google Trends spike detection (index must exceed avg × threshold)
GOOGLE_TRENDS_SPIKE_THRESHOLD=1.5

# Reddit: Create a "script" app at https://www.reddit.com/prefs/apps (redirect http://localhost) and set both.
# Without these, the collector falls back to public RSS.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:auto-trade:1.0 (local news agent)

# Optional signal sources (Stocktwits off by default – often rate-limited)
ENABLE_REDDIT=true
ENABLE_POLYMARKET=true
ENABLE_GOOGLE_TRENDS=true
ENABLE_SEC_EDGAR=true
ENABLE_STOCKTWITS=false

# ── Trading agent behaviour ───────────────────────────────────────────────────
# Committee
# Max candidate symbols after dedup
RESEARCH_SYMBOL_COUNT=15
# Slots reserved for gainers and losers
MOVER_CANDIDATE_SLOTS=6
# Slots reserved for event-discovered tickers
EVENT_CANDIDATE_SLOTS=6
# Drop candidates below this last price
MIN_CANDIDATE_PRICE=5.0
# Drop candidates below this 20-day avg volume
MIN_ADV_SHARES=500000
# Run Round 2 trader debate before chair
ENABLE_DEBATE_ROUND=true
# Max cycle duration (10 minutes)
MAX_CYCLE_SECONDS=600
# Max Alpaca orders per committee cycle
MAX_ORDERS_PER_CYCLE=3
# Traders who must agree on side for an order to survive
MIN_AGREEING_PERSONAS=2
# Minimum mean persona confidence for a surviving order
MIN_ORDER_CONFIDENCE=0.55
# New buys need a matching event unless extra traders agree
REQUIRE_CATALYST_OR_SETUP=true
# Recent earnings/guidance events count as an earnings window
EARNINGS_BLACKOUT_DAYS=5
# Reject new buys in the earnings window
BLOCK_EARNINGS_BUYS=true
# Stop distance as a multiple of 14-day ATR
STOP_ATR_MULTIPLE=2.0
# Minimum stop distance as a fraction of price
STOP_PCT=0.08
# Equity fraction risked per name (vol-aware size)
RISK_PER_NAME_PCT=0.005
# Sell held losers at or past this many days
TIME_STOP_DAYS=30
# Attach a stop after each buy
ENABLE_STOPS=true
# Bearish events at this importance block new names / sell held
BEARISH_MIN_IMPORTANCE=4
# Max new names to buy per cycle
MAX_NEW_NAMES_PER_CYCLE=1

# Event store query (trading agent)
# How far back to query events
EVENTS_SINCE_HOURS=72
# Min importance for symbol events
EVENTS_MIN_IMPORTANCE=2
EVENTS_LIMIT=30
MACRO_EVENTS_MIN_IMPORTANCE=4
MACRO_EVENTS_LIMIT=10

# Max fraction of portfolio equity per name (0.0 – 1.0)
MAX_POSITION_PCT=0.20

# Enable thinking/reasoning mode (recommended for Qwen3+ models)
ENABLE_THINKING=true
